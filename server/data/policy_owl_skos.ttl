ptv:UsagePolicy
	a owl:Class, skos:Concept ;
	rdfs:subClassOf
		dct:Policy,
		odrl:Policy ;
	[
		a owl:Restriction ;
		owl:onProperty odrl:target ;
		owl:someValuesFrom ptv:Data
	] ,
	[
		a owl:Restriction ;
		owl:onProperty odrl:action ;
		owl:hasValue odrl:use
	] ;
	skos:prefLabel "Usage Policy"@en;
	rdfs:label "Usage Policy"@en.

ptv:TermsOfUse
	a owl:Class, skos:Concept ;
	rdfs:subClassOf
		ptv:UsagePolicy ;
	skos:prefLabel "Terms Of Use"@en;
	rdfs:label "Terms Of Use"@en.
	
ptv:DataUsagePolicy	
	a owl:Class, skos:Concept ;
	rdfs:subClassOf
		ptv:UsagePolicy ;
	skos:prefLabel "Data Usage Policy"@en; 
	skos:altLabel "Information Usage Policyy"@en;
	rdfs:label"Data Usage Policy"@en.
	
