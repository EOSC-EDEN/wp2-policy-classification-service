@prefix ptv:	<https://w3id.org/ptv/> .
@prefix dct:	<http://purl.org/dc/terms/> .
@prefix odrl:	<http://www.w3.org/ns/odrl/2/> .
@prefix skos:	<http://www.w3.org/2004/02/skos/core#> .
@prefix owl:	<http://www.w3.org/2002/07/owl#> .
@prefix rdfs:	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix mod:	<https://w3id.org/mod#>.

ptv:
	a owl:Ontology ;
	rdfs:label "Policy Type Vocabulary"@en ;
	dct:title "Policy Type Vocabulary"@en ;
	dct:type  mod:SemanticArtefact;
	dct:subject "policy";
	mod:acronym "PTV";
	dct:description "An ontology for defining and classifying policy types and their relationships to established policy vocabularies such as DCTERMS and ODRL."@en;
	dct:creator "Robert Huber";
	dct:created "2026-08-11";
	dct:issued "2026-08-11";
	dct:accessRights <http://purl.org/coar/access_right/c_abf2>;
	dct:identifier "https://w3id.org/ptv/";
	dct:license <https://creativecommons.org/licenses/by-sa/4.0/>.
	
# Assets

ptv:Data
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Data"@en ;
	rdfs:comment "Represents data or information assets."@en .

ptv:Content
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Content"@en ;
	rdfs:comment "Represents content or media assets."@en .

ptv:Application
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Application"@en ;
	rdfs:comment "Represents application or software assets."@en .

ptv:Service
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Service"@en ;
	rdfs:comment "Represents service assets."@en .

ptv:Material
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Material"@en ;
	rdfs:comment "Represents material or physical assets."@en .

ptv:Organisation
	a owl:Class ;
	rdfs:subClassOf odrl:Asset ;
	skos:prefLabel "Organisation"@en ;
	rdfs:comment "Represents organisations as assets targeted by policies."@en .
	
	
# Policies

ptv:OrganisationalPolicy
	a owl:Class, skos:Concept ;
	rdfs:subClassOf
		dct:Policy,
		odrl:Policy ;
	skos:prefLabel "Organisational Policy"@en;
	skos:altLabel "Institutional Policy"@en;
	rdfs:label "Organisational Policy"@en.

ptv:AcademyPolicy
	a owl:Class, skos:Concept ;
	rdfs:subClassOf
		ptv:OrganisationalPolicy ;
	skos:prefLabel "Academy Policy"@en;
	rdfs:label "Academy Policy"@en.

